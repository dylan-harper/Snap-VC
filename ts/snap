#!/bin/sh
set -eu

root="$(cd "$(dirname "$0")" && pwd)"
project_root="$(cd "$root/.." && pwd)"
NVM_DIR="${NVM_DIR:-${HOME:-}/.nvm}"
if [ -n "$NVM_DIR" ] && [ -s "$NVM_DIR/nvm.sh" ]; then
  export NVM_DIR
  . "$NVM_DIR/nvm.sh"
  nvm use --silent "$(cat "$project_root/.nvmrc")" >/dev/null
fi
node_major="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)"
[ "$node_major" -ge 18 ] || {
  printf '%s\n' 'snap: Node.js 18 or newer is required' >&2
  exit 1
}
exec node "$root/node_modules/tsx/dist/cli.mjs" "$root/src/main.ts" "$@"
