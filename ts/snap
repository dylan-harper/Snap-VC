#!/bin/sh
set -eu

root="$(cd "$(dirname "$0")" && pwd)"
project_root="$(cd "$root/.." && pwd)"
NVM_DIR="${NVM_DIR:-${HOME:-}/.nvm}"
if [ -n "$NVM_DIR" ] && [ -s "$NVM_DIR/nvm.sh" ]; then
  export NVM_DIR
  . "$NVM_DIR/nvm.sh"
  nvm use --silent "$(cat "$project_root/.nvmrc")" >/dev/null
fi
node_version="$(node -p 'process.versions.node' 2>/dev/null || printf '%s' 'unavailable')"
node_major="${node_version%%.*}"
node_minor="${node_version#*.}"
node_minor="${node_minor%%.*}"
node_supported=false
case "$node_major" in
  20)
    case "$node_minor" in
      ''|*[!0-9]*) ;;
      *) if [ "$node_minor" -ge 19 ] 2>/dev/null; then node_supported=true; fi ;;
    esac
    ;;
  22)
    case "$node_minor" in
      ''|*[!0-9]*) ;;
      *) if [ "$node_minor" -ge 13 ] 2>/dev/null; then node_supported=true; fi ;;
    esac
    ;;
  *)
    case "$node_major" in
      ''|*[!0-9]*) ;;
      *) if [ "$node_major" -ge 24 ] 2>/dev/null; then node_supported=true; fi ;;
    esac
    ;;
esac
if [ "$node_supported" != true ]; then
  printf '%s\n' "snap: Node.js 20.19+, 22.13+, or 24+ is required (found $node_version)" >&2
  exit 1
fi
exec node "$root/node_modules/tsx/dist/cli.mjs" "$root/src/main.ts" "$@"
